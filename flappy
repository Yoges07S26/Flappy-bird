import 'dart:async';
import 'dart:math';
import 'package:flutter/material.dart';

void main() {
  runApp(const FlappyBirdApp());
}

class FlappyBirdApp extends StatelessWidget {
  const FlappyBirdApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: GameScreen(),
    );
  }
}

class GameScreen extends StatefulWidget {
  const GameScreen({super.key});

  @override
  State<GameScreen> createState() => _GameScreenState();
}

class _GameScreenState extends State<GameScreen> {
  // Bird positioning variables (Y axis ranges from "-1" at top to 1 at bottom barrier)
  double birdY = 0;

  double time = 0;
  double height = 0;
  double initialPos = 0;
  bool gameHasStarted = false;
  int score = 0;
  int highScore = 0;

  // Barrier coordinates [X-axis, width, height]
  // Barrier 1
  double barrierXOne = 1.0;
  double barrierHeightOne = 150.0; // Top barrier height in pixels
  double barrierHeightOneBottom = 150.0; // Bottom barrier height

  // Barrier 2
  double barrierXTwo = 1.8;
  double barrierHeightTwo = 100.0;
  double barrierHeightTwoBottom = 200.0;

  void startGame() {
    gameHasStarted = true;
    score = 0;
    Timer.periodic(const Duration(milliseconds: 30), (timer) {
      // Physics formula simulating acceleration due to gravity
      time += 0.04;
      height = -4.9 * time * time + 2.5 * time;

      setState(() {
        birdY = initialPos - height;

        // Move obstacles to the left
        barrierXOne -= 0.02;
        barrierXTwo -= 0.02;
      });

      // Loop barriers back to the right once they leave the screen left side
      if (barrierXOne < -1.2) {
        score++;
        barrierXOne += 2.2;
        // Generate pseudo-random heights for next cycle
        barrierHeightOne = Random().nextInt(180) + 80.0;
        barrierHeightOneBottom = 400.0 - barrierHeightOne - 130.0; // 130px gap
      }

      if (barrierXTwo < -1.2) {
        score++;
        barrierXTwo += 2.2;
        barrierHeightTwo = Random().nextInt(180) + 80.0;
        barrierHeightTwoBottom = 400.0 - barrierHeightTwo - 130.0;
      }

      // Verify if player collided or hit the boundary thresholds
      if (checkCollision() || birdY > 1.0 || birdY < -1.3) {
        timer.cancel();
        _showGameOverDialog();
      }
    });
  }

  void jump() {
    setState(() {
      time = 0;
      initialPos = birdY;
    });
  }

  bool checkCollision() {
    // Collision checking window sizes for X and Y layout bands
    // Barrier One checks
    if (barrierXOne > -0.2 && barrierXOne < 0.2) {
      if (birdY < -0.3 || birdY > 0.3) {
        return true;
      }
    }
    // Barrier Two checks
    if (barrierXTwo > -0.2 && barrierXTwo < 0.2) {
      if (birdY < -0.4 || birdY > 0.2) {
        return true;
      }
    }
    return false;
  }

  void _showGameOverDialog() {
    if (score > highScore) {
      highScore = score;
    }
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (BuildContext context) {
        return AlertDialog(
          backgroundColor: Colors.brown[700],
          title: const Center(
            child: Text(
              "G A M E  O V E R",
              style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold),
            ),
          ),
          content: Text(
            "Score: $score\nHigh Score: $highScore",
            textAlign: TextAlign.center,
            style: const TextStyle(color: Colors.white, fontSize: 18),
          ),
          actions: [
            GestureDetector(
              onTap: resetGame,
              child: ClipRRect(
                borderRadius: BorderRadius.circular(5),
                child: Container(
                  padding: const EdgeInsets.all(10),
                  color: Colors.white,
                  child: const Text(
                    "PLAY AGAIN",
                    style: TextStyle(color: Colors.brown, fontWeight: FontWeight.bold),
                  ),
                ),
              ),
            )
          ],
        );
      },
    );
  }

  void resetGame() {
    Navigator.of(context).pop();
    setState(() {
      birdY = 0;
      gameHasStarted = false;
      time = 0;
      initialPos = 0;
      barrierXOne = 1.0;
      barrierXTwo = 1.8;
      score = 0;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: GestureDetector(
        onTap: () {
          if (gameHasStarted) {
            jump();
          } else {
            startGame();
          }
        },
        child: Column(
          children: [
            // Upper Game Window
            Expanded(
              flex: 3,
              child: Container(
                color: Colors.blue,
                child: Stack(
                  children: [
                    // The Flappy Bird Character
                    AnimatedContainer(
                      alignment: Alignment(0, birdY),
                      duration: const Duration(milliseconds: 0),
                      child: const MyBird(),
                    ),

                    // Initial Start Screen Text Prompt
                    Container(
                      alignment: const Alignment(0, -0.3),
                      child: gameHasStarted
                          ? const Text("")
                          : const Text(
                              "T A P  T O  P L A Y",
                              style: TextStyle(fontSize: 22, color: Colors.white, letterSpacing: 4),
                            ),
                    ),

                    // Obstacle Pipe Set One (Top & Bottom pair)
                    AnimatedContainer(
                      alignment: Alignment(barrierXOne, -1),
                      duration: const Duration(milliseconds: 0),
                      child: MyBarrier(size: barrierHeightOne),
                    ),
                    AnimatedContainer(
                      alignment: Alignment(barrierXOne, 1),
                      duration: const Duration(milliseconds: 0),
                      child: MyBarrier(size: barrierHeightOneBottom),
                    ),

                    // Obstacle Pipe Set Two (Top & Bottom pair)
                    AnimatedContainer(
                      alignment: Alignment(barrierXTwo, -1),
                      duration: const Duration(milliseconds: 0),
                      child: MyBarrier(size: barrierHeightTwo),
                    ),
                    AnimatedContainer(
                      alignment: Alignment(barrierXTwo, 1),
                      duration: const Duration(milliseconds: 0),
                      child: MyBarrier(size: barrierHeightTwoBottom),
                    ),
                  ],
                ),
              ),
            ),

            // Ground Element Separator Line
            Container(
              height: 15,
              color: Colors.green,
            ),

            // Score Dashboard Area
            Expanded(
              child: Container(
                color: Colors.brown,
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                  children: [
                    Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        const Text("SCORE", style: TextStyle(color: Colors.white, fontSize: 20)),
                        const SizedBox(height: 10),
                        Text(score.toString(), style: const TextStyle(color: Colors.white, fontSize: 35)),
                      ],
                    ),
                    Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        const Text("BEST", style: TextStyle(color: Colors.white, fontSize: 20)),
                        const SizedBox(height: 10),
                        Text(highScore.toString(), style: const TextStyle(color: Colors.white, fontSize: 35)),
                      ],
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

// Widget component for the Bird class
class MyBird extends StatelessWidget {
  const MyBird({super.key});

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 60,
      height: 60,
      decoration: const BoxDecoration(
        color: Colors.yellow,
        shape: BoxShape.circle,
      ),
      child: const Center(
        child: Text(
          "🐥",
          style: TextStyle(fontSize: 35),
        ),
      ),
    );
  }
}

// Widget component for the Obstacle Barriers
class MyBarrier extends StatelessWidget {
  final double size;

  const MyBarrier({super.key, required this.size});

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 80,
      height: size,
      decoration: BoxDecoration(
        color: Colors.green[600],
        border: Border.all(width: 8, color: Colors.green[800]!),
        borderRadius: BorderRadius.circular(15),
      ),
    );
  }
}
